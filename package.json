{
  "name": "anchor-workspace",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm --filter './packages/**' -r build",
    "test": "vitest run scripts && pnpm -r test",
    "lint": "eslint scripts/**/*.ts && pnpm -r lint",
    "format": "prettier --write .",
    "stats:collect": "tsx scripts/collect-adoption-stats.ts",
    "stats:validate": "tsx scripts/validate-adoption-stats.ts",
    "growth:audit": "tsx scripts/growth-audit.ts",
    "site:dev": "pnpm --filter @pratik7368patil/anchor-site dev",
    "site:build": "pnpm --filter @pratik7368patil/anchor-site build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.0.8"
  }
}
